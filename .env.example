# ============ Application ============
APP_NAME=License Server
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# ============ Database ============
# sqlite | mysql | postgresql
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=license
DB_PASSWORD=change_me
DB_NAME=license_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ Security ============
# Ed25519 private key (base64). Generate via: python scripts/generate_keys.py
ED25519_PRIVATE_KEY=
# Ed25519 public key (base64)
ED25519_PUBLIC_KEY=
# JWT secret for admin sessions
JWT_SECRET=change_me_to_random_64_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ============ Admin ============
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change_me_immediately

# ============ Rate Limit ============
RATE_LIMIT_PER_IP=60
RATE_LIMIT_PER_API_KEY=300
RATE_LIMIT_WINDOW_SECONDS=60

# ============ Session ============
SESSION_EXPIRE_SECONDS=86400
SESSION_HEARTBEAT_GRACE_SECONDS=300

# ============ License ============
LICENSE_KEY_LENGTH=32
LICENSE_KEY_PREFIX=
# offline grace period in seconds (0 = must verify online)
OFFLINE_GRACE_PERIOD=0

# ============ GeoIP ============
# Path to MaxMind GeoLite2-City.mmdb, leave empty to disable geo lookup
GEOIP_DB_PATH=
GEOIP_LICENSE_KEY=

# ============ CORS ============
CORS_ORIGINS=*

# ============ Request ============
REQUEST_MAX_TIMESTAMP_SKEW_SECONDS=300
NONCE_TTL_SECONDS=600
